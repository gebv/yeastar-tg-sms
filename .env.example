# Yeastar TG SMS Gateway configuration
# Copy this file to .env and fill in your values

# ---- Yeastar Gateway ----

# Gateway IP address or hostname (required)
YEASTAR_ADDR=192.168.1.1

# AMI address in host:port format (optional, defaults to YEASTAR_ADDR:5038)
# YEASTAR_AMI_ADDR=192.168.1.1:5038

# AMI username (required)
YEASTAR_AMI_USER=

# AMI password (required)
YEASTAR_AMI_PASS=

# Web UI username (required)
YEASTAR_WEB_USER=

# Web UI password (required)
YEASTAR_WEB_PASS=

# ---- Telegram Bot ----

# Bot token from @BotFather (required)
TG_BOT_TOKEN=

# Authorized Telegram chat ID — only messages from this chat are processed (required, numeric)
TG_CHAT_ID=

# ---- Storage ----

# SQLite database file path (optional, defaults to sms.db)
# DB_PATH=sms.db

# SOCKS5 proxy for Telegram API (optional, e.g., "socks5://user:pass@host:port")
# If set, all Telegram requests are routed through this proxy.
# TG_PROXY_URL=socks5://proxy:password@10.10.10.201:8001
